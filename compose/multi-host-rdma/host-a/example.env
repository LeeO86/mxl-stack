# Copy to .env (cp example.env .env) and edit.
HOST_ID=host-a
# Management/NMOS address of host-a (browsers, registry, peers' control API).
HOST_IP=192.0.2.11
MXL_ROOT=/Volumes/mxl
# The registry runs on host-a.
NMOS_REGISTRY_ADDRESS=192.0.2.11
NMOS_REGISTRY_PORT=3210
NMOS_QUERY_PORT=3211
# Direct RDMA link host-a <-> host-b: 198.51.100.1 <-> 198.51.100.2
PEERS=[{"host_id":"host-b","local_fabric_addr":"198.51.100.1","remote_fabric_addr":"198.51.100.2","provider":"verbs"}]

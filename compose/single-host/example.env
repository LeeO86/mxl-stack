# Copy to .env (cp example.env .env) and edit.

# IPv4 address of this host that browsers and other NMOS nodes reach.
# Used as NMOS href and for WebRTC (WHEP/ICE). Not 127.0.0.1.
HOST_IP=192.0.2.10

# Host tmpfs that holds every MXL domain (see docs/requirements.md).
MXL_ROOT=/Volumes/mxl

# Prefix for NMOS seeds. All NMOS ids are UUIDv5 of the seed, so keep it
# stable and unique per stack.
STACK_ID=stack

# House format for the test player and the replay.
VIDEO_FORMAT=1080p50

# NMOS registry (the one in this compose file by default).
NMOS_REGISTRY_ADDRESS=127.0.0.1
NMOS_REGISTRY_PORT=3210
NMOS_QUERY_PORT=3211

# FlowXer API token (8-128 chars of A-Za-z0-9._~-). Set it on any shared network.
FLOWXER_API_TOKEN=
